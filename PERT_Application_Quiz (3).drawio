ml=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="540" y="180" width="210" height="80" as="geometry"/></mxCell><mxCell id="droits" value="&lt;b&gt;Droits du créateur&lt;/b&gt;&lt;br/&gt;Omar – 2 h&lt;br/&gt;&lt;font style='font-size:10px'&gt;Tôt : 3 h → 5 h | Marge : 4 h&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="540" y="280" width="210" height="80" as="geometry"/></mxCell><mxCell id="crea" value="&lt;b&gt;Création de quiz : règles de validation&lt;/b&gt;&lt;br/&gt;Maram – 1 h&lt;br/&gt;&lt;font style='font-size:10px'&gt;Tôt : 5 h → 6 h | Marge : 3 h&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="795" y="80" width="210" height="80" as="geometry"/></mxCell><mxCell id="acces" value="&lt;b&gt;Accès par code : vérification + ajustements&lt;/b&gt;&lt;br/&gt;Maram – 0.5 h&lt;br/&gt;&lt;font style='font-size:10px'&gt;Tôt : 5 h → 5.5 h | Marge : 3.5 h&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="795" y="180" width="210" height="80" as="geometry"/></mxCell><mxCell id="pcrea" value="&lt;b&gt;Page d'import de quiz&lt;/b&gt;&lt;br/&gt;Maram – 2 h&lt;br/&gt;&lt;font style='font-size:10px'&gt;Tôt : 6 h → 8 h | Marge : 1 h&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="795" y="280" width="210" height="80" as="geometry"/></mxCell><mxCell id="list" value="&lt;b&gt;Lister les quiz (nb de questions, quiz privés masqués)&lt;/b&gt;&lt;br/&gt;Omar – 1 h&lt;br/&gt;&lt;font style='font-size:10px'&gt;Tôt : 5 h → 6 h | Marge : 0 h&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fd