<mxfile host="app.diagrams.net"><diagram id="pert" name="PERT v3"><mxGraphModel dx="2320" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2320" pageHeight="600" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="PERT v3 – reste à faire au 23/10 (durées en heures ; chemin critique en rouge : 12 h, soit 3 séances de 4 h)" style="text;html=1;align=left;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1300" height="30" as="geometry"/></mxCell><mxCell id="mcd" value="&lt;b&gt;MCD (fin) – créateur, visibilité, code, scores&lt;/b&gt;&lt;br/&gt;Omar – 1 h&lt;br/&gt;&lt;font style='font-size:10px'&gt;Tôt : 0 h → 1 h | Marge : 0 h&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fde2e2;strokeColor=#b91c1c;fontSize=11;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="30" y="80" width="210" height="80" as="geometry"/></mxCell><mxCell id="fix" value="&lt;b&gt;Corriger la connexion (B1, B2, B4, B5, .gitignore)&lt;/b&gt;&lt;br/&gt;Olivier – 1.5 h&lt;br/&gt;&lt;font style='font-size:10px'&gt;Tôt : 0 h → 1.5 h | Marge : 0.5 h&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="30" y="180" width="210" height="80" as="geometry"/></mxCell><mxCell id="imp" value="&lt;b&gt;Import depuis un fichier texte&lt;/b&gt;&lt;br/&gt;Maram – 4 h&lt;br/&gt;&lt;font style='font-size:10px'&gt;Tôt : 0 h → 4 h | Marge : 1 h&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="30" y="280" width="210" height="80" as="geometry"/></mxCell><mxCell id="readme" value="&lt;b&gt;README : requirements.txt + règles d'import&lt;/b&gt;&lt;br/&gt;Omar – 0.5 h&lt;br/&gt;&lt;font style='font-size:10px'&gt;Tôt : 0 h → 0.5 h | Marge : 4.5 h&lt;/font&gt;"