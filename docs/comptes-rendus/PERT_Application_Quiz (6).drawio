<mxfile host="app.diagrams.net"><diagram id="pert" name="PERT v6"><mxGraphModel dx="1555" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1555" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="PERT v6 – reste à faire au 09/11 (durées en heures ; chemin critique en rouge : 9 h, soit 2.25 séances de 4 h)" style="text;html=1;align=left;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1300" height="30" as="geometry"/></mxCell><mxCell id="impA" value="&lt;b&gt;Import : adapter la PR n°2 + origin « saisie »&lt;/b&gt;&lt;br/&gt;Maram – 1.5 h&lt;br/&gt;&lt;font style='font-size:10px'&gt;Tôt : 0 h → 1.5 h | Marge : 4 h&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="30" y="80" width="210" height="80" as="geometry"/></mxCell><mxCell id="impR" value="&lt;b&gt;Import : relecture + fusion&lt;/b&gt;&lt;br/&gt;Omar – 0.5 h&lt;br/&gt;&lt;font style='font-size:10px'&gt;Tôt : 1.5 h → 2 h | Marge : 4 h&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="285" y="80" width="210" height="80" as="geometry"/></mxCell><mxCell id="droits" value="&lt;b&gt;Droits du créateur (PR droits-createur)&lt;/b&gt;&lt;br/&gt;Omar – 2 h&lt;br/&gt;&lt;font style='font-size:10px'&gt;Tôt : 0 h → 2 h | Marge : 4 h&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="30" y="180" width="210" height="80" as="geometry"/></mxCell><mxCell id="acces" value="&lt;b&gt;Visibilité + accès par code : vérification&lt;/b&gt;&lt;br/&gt;Maram – 0.5 h&lt;br/&gt;&lt;font style='font-size:10px'&gt;Tôt : 0 h → 0.5 h | Marge : 5.5 h&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="30" y="280" width="210" height="80" as="geometry"/></mxCell><mxCell id="ensc" value="&lt;b&gt;Enregistrer les scores (attempts)&lt;/b&gt;&lt;br/&gt;Olivier – 2 h&lt;br/&gt;&lt;font style='font-size:10px'&gt;Tôt : 0 h → 2 h | Marge : 0 h&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fde2e2;strokeColor=#b91c1c;fontSize=11;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="30" y="380" width="210" height="80" as="geometry"/></mxCell><mxCell id="list" value="&lt;b&gt;Liste des quiz (nb de questions, privés masqués)&lt;/b&gt;&lt;br/&gt;Maram – 1 h&lt;br/&gt;&lt;font style='font-size:10px'&gt;Tôt : 0 h → 1 h | Marge : 1 h&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="30" y="480" width="210" height="80" as="geometry"/></mxCell><mxCell id="corr" value="&lt;b&gt;Correction détaillée (ma réponse / la bonne)&lt;/b&gt;&lt;br/&gt;Omar – 2 h&lt;br/&gt;&lt;font style='font-size:10px'&gt;Tôt : 0 h → 2 h | Marge : 4 h&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="30" y="580" width="210" height="80" as="geometry"/></mxCell><mxCell id="hist" value="&lt;b&gt;Afficher l'historique&lt;/b&gt;&lt;br/&gt;Olivier – 2 h&lt;br/&gt;&lt;font style='font-size:10px'&gt;Tôt : 2 h → 4 h | Marge : 0 h&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fde2e2;strokeColor=#b91c1c;fontSize=11;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="285" y="180" width="210" height="80" as="geometry"/></mxCell><mxCell id="phist" value="&lt;b&gt;Page historique&lt;/b&gt;&lt;br/&gt;Omar – 2 h&lt;br/&gt;&lt;font style='font-size:10px'&gt;Tôt : 4 h → 6 h | Marge : 0 h&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fde2e2;strokeColor=#b91c1c;fontSize=11;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="540" y="80" width="210" height="80" as="geometry"/></mxCell><mxCell id="fk" value="&lt;b&gt;Clés étrangères (attempts, documents)&lt;/b&gt;&lt;br/&gt;Olivier – 1 h&lt;br/&gt;&lt;font style='font-size:10px'&gt;Tôt : 4 h → 5 h | Marge : 1 h&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="540" y="180" width="210" height="80" as="geometry"/></mxCell><mxCell id="ia" value="&lt;b&gt;Génération par IA (Groq) + plan B hors ligne&lt;/b&gt;&lt;br/&gt;Maram – 4 h&lt;br/&gt;&lt;font style='font-size:10px'&gt;Tôt : 1 h → 5 h | Marge : 1 h&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="285" y="280" width="210" height="80" as="geometry"/></mxCell><mxCell id="rappB" value="&lt;b&gt;Rapport – partie gestion de projet&lt;/b&gt;&lt;br/&gt;Sanda – 6 h&lt;br/&gt;&lt;font style='font-size:10px'&gt;Tôt : 0 h → 6 h | Marge : 3 h&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="30" y="680" width="210" height="80" as="geometry"/></mxCell><mxCell id="secu" value="&lt;b&gt;Sécurité : hachage + clé secrète&lt;/b&gt;&lt;br/&gt;Olivier – 1 h&lt;br/&gt;&lt;font style='font-size:10px'&gt;Tôt : 0 h → 1 h | Marge : 8 h&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="30" y="780" width="210" height="80" as="geometry"/></mxCell><mxCell id="tests" value="&lt;b&gt;Tests de chaque module&lt;/b&gt;&lt;br/&gt;Développeurs – 1 h&lt;br/&gt;&lt;font style='font-size:10px'&gt;Tôt : 6 h → 7 h | Marge : 0 h&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fde2e2;strokeColor=#b91c1c;fontSize=11;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="795" y="80" width="210" height="80" as="geometry"/></mxCell><mxCell id="rapp" value="&lt;b&gt;Rapport (partie produit), répétition, démo&lt;/b&gt;&lt;br/&gt;Développeurs – 2 h&lt;br/&gt;&lt;font style='font-size:10px'&gt;Tôt : 7 h → 9 h | Marge : 0 h&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fde2e2;strokeColor=#b91c1c;fontSize=11;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1050" y="80" width="210" height="80" as="geometry"/></mxCell><mxCell id="demo" value="&lt;b&gt;Démonstration finale&lt;/b&gt;&lt;br/&gt;Jalon – 23/11&lt;br/&gt;&lt;font style='font-size:10px'&gt;Au plus tôt : 9 h&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fde2e2;strokeColor=#b91c1c;fontSize=11;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1305" y="80" width="210" height="80" as="geometry"/></mxCell><mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#6b7280;strokeWidth=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="impA" target="impR"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#b91c1c;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="ensc" target="hist"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#b91c1c;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="hist" target="phist"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#6b7280;strokeWidth=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="hist" target="fk"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#6b7280;strokeWidth=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="list" target="ia"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#6b7280;strokeWidth=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="droits" target="tests"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#6b7280;strokeWidth=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="impR" target="tests"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#6b7280;strokeWidth=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="acces" target="tests"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#6b7280;strokeWidth=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="list" target="tests"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e10" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#6b7280;strokeWidth=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="corr" target="tests"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e11" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#b91c1c;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="phist" target="tests"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e12" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#6b7280;strokeWidth=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="fk" target="tests"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id