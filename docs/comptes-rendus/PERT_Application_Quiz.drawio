<mxfile host="app.diagrams.net"><diagram id="pert" name="PERT"><mxGraphModel dx="2100" dy="614" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2100" pageHeight="614" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="PERT – Application Quiz Python (durées en heures ; chemin critique en rouge : 17 h, soit 4.25 séances de 4 h)" style="text;html=1;align=left;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1100" height="30" as="geometry"/></mxCell><mxCell id="stock" value="&lt;b&gt;Choix stockage + format d'import&lt;/b&gt;&lt;br/&gt;Omar – 1 h&lt;br/&gt;&lt;font style='font-size:10px'&gt;Tôt : 0 h → 1 h | Marge : 5 h&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="30" y="80" width="210" height="78" as="geometry"/></mxCell><mxCell id="fix" value="&lt;b&gt;Corriger la connexion (+ inscription / connexion)&lt;/b&gt;&lt;br/&gt;Olivier – 4 h&lt;br/&gt;&lt;font style='font-size:10px'&gt;Tôt : 0 h → 4 h | Marge : 2 h&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="30" y="184" width="210" height="78" as="geometry"/></mxCell><mxCell id="mcd" value="&lt;b&gt;MCD&lt;/b&gt;&lt;br/&gt;Omar – 3 h&lt;br/&gt;&lt;font style='font-size:10px'&gt;Tôt : 0 h → 3 h | Marge : 0 h&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fde2e2;strokeColor=#b91c1c;fontSize=11;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="30" y="288" width="210" height="78" as="geometry"/></mxCell><mxCell id="tuser" value="&lt;b&gt;Structure / table utilisateur&lt;/b&gt;&lt;br/&gt;Olivier – 2 h&lt;br/&gt;&lt;font style='font-size:10px'&gt;Tôt : 4 h → 6 h | Marge : 2 h&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="290" y="80" width="210" height="78" as="geometry"/></mxCell><mxCell id="squiz" value="&lt;b&gt;Structure quiz / question / réponses&lt;/b&gt;&lt;br/&gt;Olivier – 2 h&lt;br/&gt;&lt;font style='font-size:10px'&gt;Tôt : 3 h → 5 h | Marge : 0 h&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fde2e2;strokeColor=#b91c1c;fontSize=11;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="290" y="184" width="210" height="78" as="geometry"/></mxCell><mxCell id="role" value="&lt;b&gt;Rôles admin / joueur&lt;/b&gt;&lt;br/&gt;Omar – 2 h&lt;br/&gt;&lt;font style='font-size:10px'&gt;Tôt : 6 h → 8 h | Marge : 2 h&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="550" y="80" width="210" height="78" as="geometry"/></mxCell><mxCell id="imp" value="&lt;b&gt;Import depuis un fichier texte&lt;/b&gt;&lt;br/&gt;Maram – 4 h&lt;br/&gt;&lt;font style='font-size:10px'&gt;Tôt : 1 h → 5 h | Marge : 5 h&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="290" y="288" width="210" height="78" as="geometry"/></mxCell><mxCell id="err" value="&lt;b&gt;Erreurs d'import&lt;/b&gt;&lt;br/&gt;Maram – 2 h&lt;br/&gt;&lt;font style='font-size:10px'&gt;Tôt : 5 h → 7 h | Marge : 10 h&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="550" y="184" width="210" height="78" as="geometry"/></mxCell><mxCell id="crea" value="&lt;b&gt;Création d'un quiz (saisie directe)&lt;/b&gt;&lt;br/&gt;Maram – 4 h&lt;br/&gt;&lt;font style='font-size:10px'&gt;Tôt : 5 h → 9 h | Marge : 5 h&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;strokeWidth=1;" vertex="1" parent="1"><m