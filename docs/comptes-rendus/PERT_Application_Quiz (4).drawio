<mxfile host="app.diagrams.net"><diagram id="pert" name="PERT v4"><mxGraphModel dx="1810" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1810" pageHeight="700" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="PERT v4 – reste à faire au 02/11 (durées en heures ; chemin critique en rouge : 11 h, soit 2.75 séances de 4 h)" style="text;html=1;align=left;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1300" height="30" as="geometry"/></mxCell><mxCell id="tables" value="&lt;b&gt;Tables alignées sur le MCD (PR)&lt;/b&gt;&lt;br/&gt;Olivier – 2 h&lt;br/&gt;&lt;font style='font-size:10px'&gt;Tôt : 0 h → 2 h | Marge : 0 h&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fde2e2;strokeColor=#b91c1c;fontSize=11;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="30" y="80" width="210" height="80" as="geometry"/></mxCell><mxCell id="revue2" value="&lt;b&gt;Relire + fusionner la PR n°2 (import)&lt;/b&gt;&lt;br/&gt;Développeurs – 0.5 h&lt;br/&gt;&lt;font style='font-size:10px'&gt;Tôt : 0 h → 0.5 h | Marge : 3.5 h&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="30" y="180" width="210" height="80" as="geometry"/></mxCell><mxCell id="crea" value="&lt;b&gt;Création : 2 à 6 réponses&lt;/b&gt;&lt;br/&gt;Maram – 1 h&lt;br/&gt;&lt;font style='font-size:10px'&gt;Tôt : 0.5 h → 1.5 h | Marge : 6.5 h&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="285" y="80" width="210" height="80" as="geometry"/></mxCell><mxCell id="req" value="&lt;b&gt;README : requirements.txt&lt;/b&gt;&lt;br/&gt;Omar – 0.5 h&lt;br/&gt;&lt;font style='font-size:10px'&gt;Tôt : 0 h → 0.5 h | Marge : 10.5 h&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="30" y="280" width="210" height="80" as="geometry"/></mxCell><mxCell id="droits" value="&lt;b&gt;Droits du créateur&lt;/b&gt;&lt;br/&gt;Omar – 2 h&lt;br/&gt;&lt;font style='font-size:10px'&gt;Tôt : 2 h → 4 h | Marge : 4 h&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="285" y="180" width="210" height="80" as="geometry"/></mxCell><mxCell id="branB" value="&lt;b&gt;Brancher l'interface – côté base&lt;/b&gt;&lt;br/&gt;Olivier – 2 h&lt;br/&gt;&lt;font style='font-size:10px'&gt;Tôt : 2 h → 4 h | Marge : 2 h&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="285" y="280" width="210" height="80" as="geometry"/></mxCell><mxCell id="branI" value="&lt;b&gt;Brancher l'interface – côté pages&lt;/b&gt;&lt;br/&gt;Maram – 2 h&lt;br/&gt;&lt;font style='font-size:10px'&gt;Tôt : 2 h → 4 h | Marge : 2 h&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="285" y="380" width="210" height="80" as="geometry"/></mxCell><mxCell id="acces" value="&lt;b&gt;Visibilité + accès par code : vérification&lt;/b&gt;&lt;br/&gt;Maram – 0.5 h&lt;br/&gt;&lt;font style='font-size:10px'&gt;Tôt : 4 h → 4.5 h | Marge : 2.5 h&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="540" y="80" width="210" height="80" as="geometry"/></mxCell><mxCell id="list" value="&lt;b&gt;Liste des quiz (nb de questions, privés masqués)&lt;/b&gt;&lt;br/&gt;Omar – 1 h&lt;br/&gt;&lt;font style='font-size:10px'&gt;Tôt : 4 h → 5 h | Marge : 3 h&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="540" y="180" width="210" height="80" as="geometry"/></mxCell><mxCell id="corr" value="&lt;b&gt;Correction détaillée (ma réponse / la bonne)&lt;/b&gt;&lt;br/&gt;Omar – 2 h&lt;br/&gt;&lt;font style='font-size:10px'&gt;Tôt : 4 h → 6 h | Marge : 2 h&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="540" y="280" width="210" height="80" as="geometry"/></mxCell><mxCell id="ensc" value="&lt;b&gt;Enregistrer les scores (table des tentatives)&lt;/b&gt;&lt;br/&gt;Olivier – 2 h&lt;br/&gt;&lt;font style='font-size:10px'&gt;Tôt : 2 h → 4 h | Marge : 0 h&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fde2e2;strokeColor=#b91c1c;fontSize=11;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="285" y="480" width="210" height="80" as="geometry"/></mxCell><mxCell id="hist" value="&lt;b&gt;Afficher l'historique&lt;/b&gt;&lt;br/&gt;Olivier – 2 h&lt;br/&gt;&lt;font style='font-size:10px'&gt;Tôt : 4 h → 6 h | Marge : 0 h&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fde2e2;strokeColor=#b91c1c;fontSize=11;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="540" y="380" width="210" height="80" as="geometry"/></mxCell><mxCell id="phist" value="&lt;b&gt;Page historique&lt;/b&gt;&lt;br/&gt;Maram – 2 h&lt;br/&gt;&lt;font style='font-size:10px'&gt;Tôt : 6 h → 8 h | Marge : 0 h&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fde2e2;strokeColor=#b91c1c;fontSize=11;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="795" y="80" width="210" height="80" as="geometry"/></mxCell><mxCell id="rappB" value="&lt;b&gt;Rapport – partie gestion de projet&lt;/b&gt;&lt;br/&gt;Sanda – 7 h&lt;br/&gt;&lt;font style='font-size:10px'&gt;Tôt : 0 h → 7 h | Marge : 4 h&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontS